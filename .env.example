# Server listens on loopback; do not expose directly to the Internet.
PORT=3000
FOCUS_DB=.data/focus-hub.sqlite
# Set true only behind a trusted HTTPS termination serving this app.
COOKIE_SECURE=false

# Exact HTTPS origin behind a trusted private forwarding endpoint; do not use wildcards.
# Codespaces startup derives this automatically from its official environment variables.
# FOCUS_PUBLIC_ORIGIN=https://<codespace-name>-3000.app.github.dev
