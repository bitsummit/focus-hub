# Node 24; loopback only. Do not expose directly to the Internet.
PORT=3000
# Set DATABASE_URL privately; no default database or automatic SQLite replacement.
# Local fictional development: npm run pg:setup (random secret, ignored .data config).
# Managed PostgreSQL URL: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
# DATABASE_URL=
DATABASE_SCHEMA=public
PG_POOL_MAX=4
# Remote TLS always validates the certificate. FOCUS_DB is legacy and rejected.
# Set true only behind a trusted HTTPS termination serving this app.
COOKIE_SECURE=false
# Codespaces derives its exact HTTPS origin automatically; no wildcards.
# FOCUS_PUBLIC_ORIGIN=https://<codespace-name>-3000.app.github.dev
